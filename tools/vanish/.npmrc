audit=true

# Pin the PUBLIC npm registry for this project, explicitly.
#
# The machine-level ~/.npmrc on the original dev machine pointed at a private
# corporate registry. That is correct for work and wrong for this: it baked
# unreachable resolved URLs into package-lock.json, so `npm ci` failed on the
# first install for any CI runner, and it published an internal host name from
# a public repo.
#
# A project-local registry line overrides the global one, so re-running
# `npm install` here cannot quietly reintroduce it.
registry=https://registry.npmjs.org/
