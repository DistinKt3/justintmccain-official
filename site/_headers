# ============================================================================
# Justin T. McCain — SIGNAL · static asset headers
# ============================================================================
#
# HOW THIS FILE ACTUALLY BEHAVES — read before editing.
#
# A request that matches several rules INHERITS THE HEADERS FROM ALL OF THEM.
# Matching a more specific path does NOT replace what a broader rule set. Two
# rules that both set the same header name produce TWO headers on the response.
#
# An earlier version of this file was written on the opposite assumption ("later
# rules override earlier ones for the same header name"). Every override in it
# was therefore silently broken, and none of it was visible without reading raw
# response headers:
#
#   - /css/*, /js/*, /assets/*, /scrubber/assets/*, /og/*, /robots.txt and
#     /sitemap.xml each returned `max-age=0, must-revalidate, max-age=31536000,
#     immutable`. The first value wins, so the year-long immutable caching never
#     applied — the fonts, the stylesheet and the 2.7 MB film revalidated on
#     every single page load.
#   - /og/* returned `Cross-Origin-Resource-Policy: same-origin, cross-origin`,
#     so the share card kept the restrictive value it was meant to opt out of.
#   - /scrubber/* returned BOTH content security policies. Browsers enforce the
#     INTERSECTION of multiple CSP headers, so the baseline silently clamped the
#     app: img-src lost `data:` and `blob:`, style-src lost `unsafe-inline`, and
#     worker-src fell back to the baseline's `default-src 'none'`. The tool
#     loaded and looked fine, while its image previews, its staggered reveals
#     and its HEIC decoder were all being blocked.
#
# THE FIX, used on every override below: detach the inherited header first with
# `! Header-Name`, then set the value you actually want. Detaching without
# re-setting leaves the response with no such header at all, which for a CSP
# means fail-open — so the two lines always travel together.
#
# When you add a rule here, verify it against a real deploy rather than reading
# it back. `deploy/verify.mjs` asserts there is exactly one of each of these.

/*
  # --- Content Security Policy ---------------------------------------------
  # default-src 'none' means every fetch type must be named explicitly below.
  # Verified against the built output: no inline styles, no data: URIs, and one
  # 51-byte inline script (the no-js class removal), pinned by hash rather than
  # allowed via 'unsafe-inline'. The JSON-LD block is type=application/ld+json,
  # a data block the browser never executes, so it needs no hash.
  # If you add a script, add its hash here or the browser will refuse to run it.
  Content-Security-Policy: default-src 'none'; script-src 'self' 'sha256-tuKyZn/3ycw/MNMDii/kvSPrelo6SCsJSecqb1n2neg='; style-src 'self'; img-src 'self'; font-src 'self'; media-src 'self'; manifest-src 'self'; connect-src 'none'; form-action 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests

  # --- Transport ------------------------------------------------------------
  # Two years, subdomains included. `preload` is intentionally omitted: joining
  # the browser preload list is slow to reverse and binds every future
  # subdomain to HTTPS. Add it once the domain is settled, not on day one.
  Strict-Transport-Security: max-age=63072000; includeSubDomains

  # --- Leakage --------------------------------------------------------------
  # no-referrer, not the usual strict-origin-when-cross-origin: when a visitor
  # clicks through to LinkedIn, LinkedIn learns nothing about where they came
  # from. There is no analytics here that would miss the referrer anyway.
  Referrer-Policy: no-referrer

  # Opt out of browser features this site has no use for, including the Topics
  # API and its FLoC predecessor. Saying no in a header is cheap and explicit.
  Permissions-Policy: accelerometer=(), autoplay=(), browsing-topics=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), interest-cohort=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=(), xr-spatial-tracking=()

  # --- Discovery ------------------------------------------------------------
  # This site is shared, not found. The same directive is in a <meta> tag on
  # every page; this header is the half that covers everything which is NOT
  # HTML and therefore cannot carry a meta tag — the OG image, the master film,
  # the fonts, robots.txt itself. Without it those remain independently
  # indexable even while the pages are not.
  #
  # robots.txt deliberately still ALLOWS crawling, because a crawler that is
  # blocked can never read this. See the reasoning in site/robots.txt.
  #
  # noarchive/nosnippet are belt and braces for partial compliance: if some
  # engine honours only part of this, it still cannot show a cached copy or a
  # text excerpt.
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet

  # --- Hardening ------------------------------------------------------------
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin

  # --- Caching --------------------------------------------------------------
  # HTML must revalidate, or a content fix would sit behind a stale cache.
  # Every rule below that wants a different value must DETACH this one first.
  Cache-Control: public, max-age=0, must-revalidate

# Versioned assets. Every reference from the HTML carries ?v=<ASSET_VERSION>,
# and browsers cache per full URL including the query, so a version bump is a
# guaranteed cache miss. This is safe ONLY while that discipline holds: bump
# ASSET_VERSION in build/build.mjs whenever CSS or JS changes, or clients will
# hold the old file for a year.
/css/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/js/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Fonts, images and the master film. These change by replacement, never in
# place, so they are safely immutable.
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# ============================================================================
# /scrubber/* — Metadata Scrubber (React SPA, built from tools/metadata-scrubber)
# ============================================================================
#
# The baseline is `default-src 'none'` with ONE pinned script hash. That is
# correct for a hand-built static page and fatal for a bundled SPA: the
# Scrubber's module bundle has a different hash on every build, so it cannot be
# pinned. Hence a scoped policy — and the detach above it, without which the
# browser intersects the two and clamps the app.
#
# WHY THIS POLICY AND NOT A TIGHTER ONE:
#   The app also ships its own <meta http-equiv="Content-Security-Policy">.
#   When both are present the browser enforces the INTERSECTION, so the
#   effective policy is only ever as strict as the stricter of the two. This
#   header mirrors that meta tag directive-for-directive, deliberately: it means
#   adding this header cannot change the app's runtime behaviour. Writing
#   something tighter here would break a working code path, and the failure
#   would only appear in production.
#
#   To tighten the Scrubber, tighten the meta tag in
#   tools/metadata-scrubber/index.html and mirror the change here. One policy,
#   two enforcement points, no drift.
#
# connect-src 'self' — NOT 'none'. It is what the app declares, and the bundle
#   contains fetch/XHR call sites inside the HEIC decoder's runtime. 'self' is
#   still the load-bearing guarantee for "nothing is uploaded": there is no
#   endpoint under /scrubber/ to upload to, so a third party is unreachable by
#   construction, which is the claim the landing page makes.
#
# worker-src blob: — the HEIC decoder constructs a worker from a Blob.
/scrubber/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; worker-src 'self' blob:; form-action 'none'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# Vite emits content-hashed filenames, so these are immutable by construction:
# a change to either produces a new filename rather than new bytes at the same
# one. This needs no ASSET_VERSION discipline, unlike /css/* and /js/* above.
/scrubber/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/scrubber/fonts/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# The share card must stay fetchable by crawlers that render link previews, so
# it opts out of the same-origin resource policy set above. Without the detach
# the response carried `same-origin, cross-origin` and kept the restrictive
# value, which is the failure this rule existed to prevent.
/og/*
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin
  ! Cache-Control
  Cache-Control: public, max-age=604800

# Crawler-facing files: short cache so a change to either is picked up quickly.
/robots.txt
  ! Cache-Control
  Cache-Control: public, max-age=3600
/sitemap.xml
  ! Cache-Control
  Cache-Control: public, max-age=3600
